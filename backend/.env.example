# Application
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_auth

# Security (MUST be a strong random value, >= 32 chars; placeholders are rejected)
SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider (Groq)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=openai/gpt-oss-120b
FALLBACK_MODEL=llama-3.3-70b-versatile

# Uploads & CORS
UPLOAD_DIR=uploads
STORAGE_PROVIDER=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RAG / embeddings (document search)
RAG_ENABLED=true
RAG_TOP_K=5
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_API_URL=https://router.huggingface.co/hf-inference/models
# Required: Hugging Face token with Inference API access (https://huggingface.co/settings/tokens)
EMBEDDING_API_KEY=your-huggingface-api-key

# pgvector (requires PostgreSQL extension). Leave false for local JSON embeddings.
USE_PGVECTOR=false

# Auto-migrate database on startup (set false in production if using entrypoint.sh)
AUTO_MIGRATE=true

# Moderation / guardrails
MODERATION_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Database connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30
