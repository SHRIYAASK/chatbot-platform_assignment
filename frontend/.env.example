# Required in Vercel (Project Settings → Environment Variables → Production)
# Must be set before build — Vite bakes this into the bundle.
VITE_API_URL=https://your-backend.up.railway.app

# Optional: shown on the Synora landing page footer/header
# VITE_GITHUB_REPO_URL=https://github.com/your-org/your-repo

# Local development
# VITE_API_URL=http://127.0.0.1:8002
